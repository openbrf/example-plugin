{
  "name": "@openbrf/example-plugin",
  "version": "0.1.0",
  "description": "Reference Open BRF plugin: how many apartments, residents and members the association has, and which apartments have no resident the plugin can see.",
  "license": "MIT-0",
  "type": "module",
  "homepage": "https://github.com/openbrf/example-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbrf/example-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/openbrf/example-plugin/issues"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/rename-server-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run",
    "check:package": "node scripts/check-package.mjs"
  },
  "openbrf": {
    "apiVersion": 1,
    "id": "occupancy",
    "entry": {
      "server": "./dist/server.cjs",
      "client": "./dist/remoteEntry.js"
    },
    "permissions": [
      "addressBook:read"
    ],
    "personalData": [
      "name",
      "apartment",
      "residency"
    ],
    "view": {
      "module": "./View",
      "titleKey": "view.title"
    },
    "settingsSchema": {
      "fields": [
        {
          "key": "heading",
          "labelKey": "settings.heading.label",
          "hintKey": "settings.heading.hint",
          "type": "text",
          "default": "",
          "maxLength": 80
        },
        {
          "key": "showMembers",
          "labelKey": "settings.showMembers.label",
          "type": "boolean",
          "default": true
        },
        {
          "key": "grouping",
          "labelKey": "settings.grouping.label",
          "type": "select",
          "default": "address",
          "options": [
            {
              "value": "address",
              "labelKey": "settings.grouping.address"
            },
            {
              "value": "floor",
              "labelKey": "settings.grouping.floor"
            }
          ]
        },
        {
          "key": "rowLimit",
          "labelKey": "settings.rowLimit.label",
          "hintKey": "settings.rowLimit.hint",
          "type": "number",
          "integer": true,
          "min": 1,
          "max": 500,
          "default": 100
        }
      ]
    },
    "actions": [
      {
        "id": "summary",
        "capability": "addressBook:read",
        "effect": "read",
        "personalData": [],
        "surfaces": [
          "ui",
          "mcp"
        ]
      }
    ]
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@module-federation/vite": "1.23.5",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/testing": "12.2.0",
    "@openbrf/plugin-sdk": "1.0.0",
    "@openbrf/theme-tools": "1.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "i18next": "26.5.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
